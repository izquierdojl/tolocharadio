# --- Servidor ---
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/tolocharadio.db

# --- JWT ---
# OBLIGATORIAS en produccion (minimo 32 caracteres). Usa secreto con openssl rand -hex 32.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# --- Refresco de sesion (deslizante) ---
# Vida minima del refresh token para NO rotarlo en un refresh (duracion: 15m, 2h, 24h, 7d...).
# Al llegar al final de su vida se rota dejando el anterior valido durante REFRESH_GRACE_MS.
REFRESH_ROTATE_THRESHOLD=24h
REFRESH_GRACE_MS=60000

# --- Registro ---
# Desactiva el registro abierto en produccion (true/false).
REGISTRATION_ENABLED=true

# --- CORS ---
# "*" o lista de origenes separada por comas.
CORS_ORIGINS=*

# --- radio-browser.info ---
RADIOBROWSER_BASE_URL=https://de1.api.radio-browser.info
RADIOBROWSER_APP_NAME=TolochaRadio

# --- Cache y limites ---
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
HISTORY_LIMIT=50

# --- Estadisticas de escucha ---
# Zona horaria IANA de los acumulados por hora/dia.
STATS_TIMEZONE=Europe/Madrid
# Intervalo de volcado del tiempo de escucha en memoria (ms).
STATS_FLUSH_INTERVAL_MS=30000
# Tope de tiempo acreditado entre dos pulsos consecutivos (ms).
STATS_PULSE_CAP_MS=15000
# Inactividad maxima en HLS antes de cerrar una escucha (ms).
STATS_HLS_IDLE_MS=60000

# --- Estaticos del frontend (solo prod) ---
STATIC_DIR=/app/web