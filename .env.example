# --- Servidor ---
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/tolocharadio.db

# --- JWT ---
# OBLIGATORIAS en produccion (minimo 32 caracteres). Usa secreto con openssl rand -hex 32.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# --- Registro ---
# Desactiva el registro abierto en produccion (true/false).
REGISTRATION_ENABLED=true

# --- CORS ---
# "*" o lista de origenes separada por comas.
CORS_ORIGINS=*

# --- radio-browser.info ---
RADIOBROWSER_BASE_URL=https://de1.api.radio-browser.info
RADIOBROWSER_APP_NAME=TolochaRadio

# --- Cache y limites ---
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
HISTORY_LIMIT=50

# --- Estaticos del frontend (solo prod) ---
STATIC_DIR=/app/web